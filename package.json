{
  "name": "mirror-daily-event-site",
  "type": "module",
  "private": true,
  "description": "Monorepo of statically generated event sites for Mirror Daily",
  "scripts": {
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4"
  },
  "lint-staged": {
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
